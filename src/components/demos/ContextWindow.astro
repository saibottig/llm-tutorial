---
import { t, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t(locale);
---

<section
  class="demo ctx"
  id="ctx-demo"
  data-compacted={tr('ctx.compacted')}
  data-overflow={tr('ctx.overflow')}
  data-used={tr('ctx.used')}
>
  <div class="demo__head">
    <span class="demo__badge">{tr('demo.title')}</span>
    <span class="demo__title">{tr('ctx.title')}</span>
  </div>
  <div class="demo__body">
    <div class="demo__controls">
      <label class="field">
        <span class="field__label">
          <span>{tr('ctx.windowSize')}</span>
        </span>
        <select id="ctx-window">
          <option value="200000">200k</option>
          <option value="1000000" selected>1M</option>
        </select>
      </label>

      <label class="field">
        <span class="field__label">
          <span>{tr('ctx.turns')}</span>
          <span class="field__value" id="ctx-turns-out">24</span>
        </span>
        <input type="range" id="ctx-turns" min="0" max="300" step="1" value="24" />
      </label>

      <label class="field">
        <span class="field__label">
          <span>{tr('ctx.mcpServers')}</span>
          <span class="field__value" id="ctx-mcp-out">3</span>
        </span>
        <input type="range" id="ctx-mcp" min="0" max="12" step="1" value="3" />
      </label>
    </div>

    <div class="stack" id="ctx-stack" role="img" aria-label={tr('ctx.title')}>
      <div class="stack__seg" data-seg="system"></div>
      <div class="stack__seg" data-seg="tools"></div>
      <div class="stack__seg" data-seg="history"></div>
      <div class="stack__seg" data-seg="message"></div>
      <div class="stack__seg" data-seg="free"></div>
    </div>

    <div class="legend">
      <span class="legend__item"
        ><i class="legend__swatch" data-sw="system"></i>{tr('ctx.system')}
        <b class="legend__num" id="ctx-n-system"></b></span
      >
      <span class="legend__item"
        ><i class="legend__swatch" data-sw="tools"></i>{tr('ctx.tools')}
        <b class="legend__num" id="ctx-n-tools"></b></span
      >
      <span class="legend__item"
        ><i class="legend__swatch" data-sw="history"></i>{tr('ctx.history')}
        <b class="legend__num" id="ctx-n-history"></b></span
      >
      <span class="legend__item"
        ><i class="legend__swatch" data-sw="message"></i>{tr('ctx.message')}
        <b class="legend__num" id="ctx-n-message"></b></span
      >
      <span class="legend__item"
        ><i class="legend__swatch" data-sw="free"></i>{tr('ctx.free')}
        <b class="legend__num" id="ctx-n-free"></b></span
      >
    </div>

    <div class="stats">
      <div class="stat stat--accent">
        <div class="stat__label">{tr('ctx.used')}</div>
        <div class="stat__value" id="ctx-used">–</div>
      </div>
      <div class="stat">
        <div class="stat__label">{tr('ctx.tools')}</div>
        <div class="stat__value" id="ctx-toolshare">–</div>
      </div>
    </div>

    <div class="btnrow" style="margin-top:1rem">
      <button class="btn" id="ctx-compact" type="button">{tr('ctx.compact')}</button>
      <button class="btn" id="ctx-reset" type="button">{tr('demo.reset')}</button>
    </div>

    <p class="statusline statusline--ok" id="ctx-status" hidden></p>
  </div>
</section>

<script>
  const root = document.getElementById('ctx-demo');
  if (root) {
    // Rough but realistic per-item token costs.
    const SYSTEM = 1400;
    const PER_MCP = 1500; // tool definitions for one mid-sized server
    const PER_TURN = 750; // one user message + one assistant reply
    const MESSAGE = 400;

    const els = {
      window: document.getElementById('ctx-window') as HTMLSelectElement,
      turns: document.getElementById('ctx-turns') as HTMLInputElement,
      mcp: document.getElementById('ctx-mcp') as HTMLInputElement,
      turnsOut: document.getElementById('ctx-turns-out')!,
      mcpOut: document.getElementById('ctx-mcp-out')!,
      stack: document.getElementById('ctx-stack')!,
      used: document.getElementById('ctx-used')!,
      toolshare: document.getElementById('ctx-toolshare')!,
      status: document.getElementById('ctx-status') as HTMLElement,
      compact: document.getElementById('ctx-compact')!,
      reset: document.getElementById('ctx-reset')!,
    };

    let compacted = false;
    const fmt = new Intl.NumberFormat(document.documentElement.lang || 'de');

    function update() {
      const windowSize = Number(els.window.value);
      const turns = Number(els.turns.value);
      const mcp = Number(els.mcp.value);

      els.turnsOut.textContent = String(turns);
      els.mcpOut.textContent = String(mcp);

      const tools = mcp * PER_MCP;
      // Compaction summarises older turns; the most recent few stay verbatim.
      const rawHistory = turns * PER_TURN;
      const history = compacted ? Math.round(rawHistory * 0.22) : rawHistory;

      const parts = { system: SYSTEM, tools, history, message: MESSAGE };
      const total = parts.system + parts.tools + parts.history + parts.message;
      const free = Math.max(0, windowSize - total);
      const overflow = total > windowSize;
      // When over capacity, scale against the request rather than the window so
      // the bar still shows the proportions of what was asked for.
      const scale = overflow ? total : windowSize;

      for (const [seg, value] of Object.entries({ ...parts, free })) {
        const el = els.stack.querySelector<HTMLElement>(`[data-seg="${seg}"]`);
        if (el) el.style.flexBasis = `${(value / scale) * 100}%`;
        const num = document.getElementById(`ctx-n-${seg}`);
        if (num) num.textContent = value ? fmt.format(value) : '0';
      }

      const pct = (total / windowSize) * 100;
      els.used.textContent = `${pct.toFixed(0)} %`;
      els.toolshare.textContent = total ? `${((tools / total) * 100).toFixed(0)} %` : '0 %';

      els.status.hidden = !(overflow || compacted);
      if (overflow) {
        els.status.textContent = root.dataset.overflow!;
        els.status.className = 'statusline statusline--bad';
      } else if (compacted) {
        els.status.textContent = root.dataset.compacted!;
        els.status.className = 'statusline statusline--ok';
      }
    }

    els.window.addEventListener('change', update);
    els.turns.addEventListener('input', () => {
      compacted = false;
      update();
    });
    els.mcp.addEventListener('input', update);
    els.compact.addEventListener('click', () => {
      compacted = !compacted;
      update();
    });
    els.reset.addEventListener('click', () => {
      compacted = false;
      els.window.value = '1000000';
      els.turns.value = '24';
      els.mcp.value = '3';
      update();
    });

    update();
  }
</script>

<style>
  .ctx :global([data-seg='system']),
  .ctx :global([data-sw='system']) {
    background: var(--accent);
  }
  .ctx :global([data-seg='tools']),
  .ctx :global([data-sw='tools']) {
    background: var(--warn);
  }
  .ctx :global([data-seg='history']),
  .ctx :global([data-sw='history']) {
    background: var(--info);
  }
  .ctx :global([data-seg='message']),
  .ctx :global([data-sw='message']) {
    background: #c58af9;
  }
  .ctx :global([data-seg='free']),
  .ctx :global([data-sw='free']) {
    background: var(--surface-hi);
  }
</style>
