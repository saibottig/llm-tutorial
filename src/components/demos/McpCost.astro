---
import { t, type Locale } from '../../i18n/ui';
// Shared with the terminal playground so the two demos cannot quote different
// numbers for the same servers.
import { MCP_SERVERS as SERVERS } from '../../lib/terminal/world';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t(locale);
---

<section
  class="demo mcp"
  id="mcp-demo"
  data-share={tr('mcp.share')}
  data-perrequest={tr('mcp.perRequest')}
>
  <div class="demo__head">
    <span class="demo__badge">{tr('demo.title')}</span>
    <span class="demo__title">{tr('mcp.title')}</span>
  </div>
  <div class="demo__body">
    <div class="mcp__servers">
      {
        SERVERS.map((s) => (
          <label class="mcp__server">
            <input type="checkbox" data-server={s.id} data-tokens={s.tokens} data-tools={s.tools} checked={s.on} />
            <span class="mcp__name">{s.name}</span>
            <span class="mcp__meta u-mono">
              {s.tools} {tr('mcp.tools')} · {s.tokens.toLocaleString(locale)}
            </span>
          </label>
        ))
      }
    </div>

    <div class="btnrow" style="margin-top:.8rem">
      <button class="btn" id="mcp-all" type="button">{tr('mcp.allOn')}</button>
      <button class="btn" id="mcp-none" type="button">{tr('mcp.allOff')}</button>
    </div>

    <div class="stats">
      <div class="stat stat--warn">
        <div class="stat__label">{tr('mcp.tokens')}</div>
        <div class="stat__value" id="mcp-tokens">–</div>
      </div>
      <div class="stat">
        <div class="stat__label">{tr('mcp.tools')}</div>
        <div class="stat__value" id="mcp-tools">–</div>
      </div>
      <div class="stat stat--accent">
        <div class="stat__label">{tr('mcp.skillsCompare')}</div>
        <div class="stat__value" id="mcp-skills">–</div>
      </div>
    </div>

    <p class="statusline statusline--warn" id="mcp-status"></p>
  </div>
</section>

<script>
  import { SKILL_HEADER_TOKENS, SESSION } from '../../lib/terminal/world';

  const root = document.getElementById('mcp-demo');
  if (root) {
    const WINDOW = SESSION.windowSize;

    const boxes = [...root.querySelectorAll<HTMLInputElement>('[data-server]')];
    const lang = document.documentElement.lang || 'de';
    const fmt = new Intl.NumberFormat(lang);

    function update() {
      let tokens = 0;
      let tools = 0;
      for (const box of boxes) {
        if (!box.checked) continue;
        tokens += Number(box.dataset.tokens);
        tools += Number(box.dataset.tools);
      }
      const skills = tools * SKILL_HEADER_TOKENS;

      document.getElementById('mcp-tokens')!.textContent = fmt.format(tokens);
      document.getElementById('mcp-tools')!.textContent = fmt.format(tools);
      document.getElementById('mcp-skills')!.textContent = fmt.format(skills);

      const share = (tokens / WINDOW) * 100;
      const status = document.getElementById('mcp-status')!;
      status.textContent =
        `${fmt.format(tokens)} ${root.dataset.perrequest} — ${share.toFixed(1)} % ${root.dataset.share} (200k).`;
      status.className =
        share > 8
          ? 'statusline statusline--bad'
          : share > 3
            ? 'statusline statusline--warn'
            : 'statusline statusline--ok';
    }

    boxes.forEach((b) => b.addEventListener('change', update));
    document.getElementById('mcp-all')!.addEventListener('click', () => {
      boxes.forEach((b) => (b.checked = true));
      update();
    });
    document.getElementById('mcp-none')!.addEventListener('click', () => {
      boxes.forEach((b) => (b.checked = false));
      update();
    });

    update();
  }
</script>

<style>
  .mcp__servers {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13.5rem, 1fr));
    gap: 0.4rem;
  }

  .mcp__server {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.3rem 0.55rem;
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    cursor: pointer;
  }

  .mcp__server:hover {
    border-color: var(--border-hi);
  }

  .mcp__server:has(input:checked) {
    border-color: color-mix(in srgb, var(--warn) 45%, transparent);
    background: var(--warn-wash);
  }

  .mcp__server input {
    accent-color: var(--warn);
    cursor: pointer;
    margin: 0;
  }

  .mcp__name {
    font-size: 0.87rem;
    font-weight: 600;
  }

  .mcp__meta {
    grid-column: 2;
    font-size: 0.72rem;
    color: var(--text-faint);
  }
</style>
