---
import { encode as encodeO200k } from 'gpt-tokenizer/encoding/o200k_base';
import { encode as encodeCl100k } from 'gpt-tokenizer/encoding/cl100k_base';
import { decode as decodeO200k } from 'gpt-tokenizer/encoding/o200k_base';
import { t, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t(locale);

/**
 * Examples are tokenised here, at build time, so the chapter renders something
 * real without shipping the 1 MB BPE table to every visitor. The table is only
 * fetched if someone asks to tokenise their own text.
 */
const SAMPLES: { de: string; en: string; note: { de: string; en: string } }[] = [
  {
    de: 'Ein Sprachmodell verarbeitet Text nicht als Wörter, sondern als Token.',
    en: 'A language model does not process text as words, but as tokens.',
    note: {
      de: 'Normaler Fließtext — hier liegen beide Sprachen fast gleichauf.',
      en: 'Ordinary prose — the two languages are almost level here.',
    },
  },
  {
    de: 'Rechtsschutzversicherungsgesellschaft',
    en: 'legal expenses insurance company',
    note: {
      de: 'Komposita sind der Fall, in dem Deutsch tatsächlich teurer wird.',
      en: 'Compound nouns are where German genuinely does cost more.',
    },
  },
  {
    de: 'Die Kontextfenstergröße bestimmt, wie viele Token gleichzeitig verarbeitet werden können.',
    en: 'The context window size determines how many tokens can be processed at once.',
    note: {
      de: 'Fachtext mit Komposita — der Aufschlag bleibt im einstelligen Prozentbereich.',
      en: 'Technical prose with compounds — the surcharge stays in single-digit percent.',
    },
  },
];

type Piece = { text: string; id: number };

function pieces(text: string): Piece[] {
  return encodeO200k(text).map((id) => {
    const decoded = decodeO200k([id]);
    // A single token can be half of a multi-byte character; show a marker
    // rather than a bare replacement glyph when that happens.
    return { text: decoded.includes('�') ? '◌' : decoded, id };
  });
}

const samples = SAMPLES.map((s) => ({
  note: s.note[locale],
  langs: (['de', 'en'] as const).map((l) => {
    const text = s[l];
    const p = pieces(text);
    return {
      lang: l,
      text,
      pieces: p,
      tokens: p.length,
      chars: [...text].length,
      legacy: encodeCl100k(text).length,
    };
  }),
}));

// The headline comparison uses its own representative paragraph rather than
// the three samples above: one of those is a single compound noun chosen to
// show the worst case, and averaging it in would skew the figure downwards.
const paragraphDe =
  'Ein Sprachmodell verarbeitet Text nicht als Buchstaben oder Wörter, sondern als Token. ' +
  'Das ist die kleinste Einheit, in der es Text überhaupt wahrnimmt. Wie viele Token ein ' +
  'Text ergibt, hängt vom Tokenizer des Modells ab und liegt für ein bestimmtes Modell fest. ' +
  'Der gesamte Gesprächsverlauf wird bei jeder Anfrage erneut mitgeschickt, weil das Modell ' +
  'selbst zustandslos ist und sich zwischen zwei Aufrufen an nichts erinnert.';
const paragraphEn =
  'A language model does not process text as letters or words, but as tokens. ' +
  'That is the smallest unit in which it perceives text at all. How many tokens a ' +
  'text produces depends on the tokenizer of the model and is fixed for any given model. ' +
  'The entire conversation history is sent again with every request, because the model ' +
  'itself is stateless and remembers nothing between two calls.';
const overall = {
  deModern: encodeO200k(paragraphDe).length,
  enModern: encodeO200k(paragraphEn).length,
  deLegacy: encodeCl100k(paragraphDe).length,
  enLegacy: encodeCl100k(paragraphEn).length,
};
---

<section class="demo tokenizer">
  <div class="demo__head">
    <span class="demo__badge">{tr('demo.title')}</span>
    <span class="demo__title">{tr('tokenizer.title')}</span>
  </div>
  <div class="demo__body">
    <p class="demo__note" style="margin-bottom:1rem">{tr('tokenizer.intro')}</p>

    {
      samples.map((sample) => (
        <div class="tk__sample">
          {sample.langs.map((s) => (
            <div class="tk__row">
              <span class="tk__lang">{s.lang.toUpperCase()}</span>
              <div class="tk__chips">
                {s.pieces.map((p, i) => (
                  <span class="tk__chip" data-alt={i % 2 === 1 ? 'true' : 'false'} title={`#${p.id}`}>
                    {p.text.replace(/ /g, '·').replace(/\n/g, '↵')}
                  </span>
                ))}
              </div>
              <span class="tk__count u-tabular">
                {s.tokens}
                <small> {tr('tokenizer.tokens')}</small>
              </span>
            </div>
          ))}
          <p class="tk__note">{sample.note}</p>
        </div>
      ))
    }

    <div class="tk__summary">
      <div class="tk__summaryRow">
        <span class="tk__summaryLabel">o200k_base <em>{locale === 'de' ? 'aktuell' : 'current'}</em></span>
        <span class="u-mono u-tabular">DE {overall.deModern} · EN {overall.enModern}</span>
        <strong class="tk__delta tk__delta--good">
          +{Math.round((overall.deModern / overall.enModern - 1) * 100)}&thinsp;%
        </strong>
      </div>
      <div class="tk__summaryRow">
        <span class="tk__summaryLabel">cl100k_base <em>{locale === 'de' ? 'älter' : 'older'}</em></span>
        <span class="u-mono u-tabular">DE {overall.deLegacy} · EN {overall.enLegacy}</span>
        <strong class="tk__delta tk__delta--bad">
          +{Math.round((overall.deLegacy / overall.enLegacy - 1) * 100)}&thinsp;%
        </strong>
      </div>
      <p class="tk__note" style="margin-top:.6rem">
        {
          locale === 'de'
            ? 'Aufschlag für Deutsch gegenüber demselben Inhalt auf Englisch. Derselbe Text, zwei Tokenizer — die Zahl hängt am Modell, nicht am Text.'
            : 'Surcharge for German against the same content in English. Same text, two tokenizers — the number depends on the model, not the text.'
        }
      </p>
    </div>

    <div
      class="tk__live"
      id="tk-live"
      data-loading={tr('tokenizer.loading')}
      data-error={tr('tokenizer.error')}
    >
      <button class="btn btn--primary" id="tk-load" type="button">{tr('tokenizer.load')}</button>
      <div id="tk-panel" hidden>
        <textarea id="tk-input" placeholder={tr('tokenizer.placeholder')} rows="3"></textarea>
        <div class="tk__chips tk__chips--live" id="tk-out"></div>
        <div class="stats">
          <div class="stat stat--accent">
            <div class="stat__label">{tr('tokenizer.tokens')}</div>
            <div class="stat__value" id="tk-tokens">0</div>
          </div>
          <div class="stat">
            <div class="stat__label">{tr('tokenizer.chars')}</div>
            <div class="stat__value" id="tk-chars">0</div>
          </div>
          <div class="stat">
            <div class="stat__label">{tr('tokenizer.ratio')}</div>
            <div class="stat__value" id="tk-ratio">–</div>
          </div>
        </div>
      </div>
      <p class="tk__note" id="tk-status" hidden></p>
    </div>
  </div>
</section>

{/* Strings ride on data-attributes rather than define:vars: a define:vars
    script is implicitly inline, so Vite would leave the dynamic import as a
    bare specifier the browser cannot resolve. */}
<script>
  const live = document.getElementById('tk-live');
  const strings = {
    loading: live?.dataset.loading ?? 'Loading …',
    error: live?.dataset.error ?? 'Could not load the tokenizer.',
  };
  const loadBtn = document.getElementById('tk-load');
  const panel = document.getElementById('tk-panel');
  const status = document.getElementById('tk-status');
  const input = document.getElementById('tk-input');
  const out = document.getElementById('tk-out');
  const elTokens = document.getElementById('tk-tokens');
  const elChars = document.getElementById('tk-chars');
  const elRatio = document.getElementById('tk-ratio');

  let codec = null;

  function render() {
    if (!codec || !input) return;
    const text = input.value;
    const ids = codec.encode(text);
    out.textContent = '';
    // Cap the rendered chips; the counters still reflect the whole input.
    ids.slice(0, 400).forEach((id, i) => {
      const chip = document.createElement('span');
      chip.className = 'tk__chip';
      chip.dataset.alt = i % 2 === 1 ? 'true' : 'false';
      chip.title = '#' + id;
      const piece = codec.decode([id]);
      chip.textContent = piece.includes('�')
        ? '◌'
        : piece.replace(/ /g, '·').replace(/\n/g, '↵');
      out.appendChild(chip);
    });
    if (ids.length > 400) {
      const more = document.createElement('span');
      more.className = 'tk__chip tk__chip--more';
      more.textContent = '+' + (ids.length - 400);
      out.appendChild(more);
    }
    const chars = [...text].length;
    elTokens.textContent = String(ids.length);
    elChars.textContent = String(chars);
    elRatio.textContent = ids.length ? (chars / ids.length).toFixed(2) : '–';
  }

  loadBtn?.addEventListener('click', async () => {
    loadBtn.disabled = true;
    status.hidden = false;
    status.textContent = strings.loading;
    try {
      codec = await import('gpt-tokenizer/encoding/o200k_base');
      loadBtn.hidden = true;
      status.hidden = true;
      panel.hidden = false;
      input.value = 'Donaudampfschifffahrtsgesellschaft vs. Danube steamship company';
      render();
      input.focus();
    } catch {
      status.textContent = strings.error;
      loadBtn.disabled = false;
    }
  });

  input?.addEventListener('input', render);
</script>

<style>
  .tk__sample {
    padding: 0.75rem 0;
    border-bottom: 1px dashed var(--border);
  }

  .tk__row {
    display: grid;
    grid-template-columns: 1.9rem minmax(0, 1fr) auto;
    gap: 0.6rem;
    align-items: start;
    padding: 0.22rem 0;
  }

  .tk__lang {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--text-faint);
    padding-top: 0.25rem;
    letter-spacing: 0.05em;
  }

  .tk__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
    min-width: 0;
  }

  .tk__chip {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.5;
    padding: 0.08rem 0.28rem;
    border-radius: 4px;
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    color: var(--text);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .tk__chip[data-alt='true'] {
    background: color-mix(in srgb, var(--info) 17%, transparent);
  }

  .tk__chip--more {
    background: var(--surface-hi);
    color: var(--text-faint);
  }

  .tk__count {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
    padding-top: 0.15rem;
  }

  .tk__count small {
    font-size: 0.66rem;
    color: var(--text-faint);
    font-weight: 500;
  }

  .tk__note {
    font-size: 0.78rem;
    color: var(--text-faint);
    line-height: 1.5;
    margin-top: 0.4rem;
    padding-left: 2.5rem;
  }

  .tk__summary {
    margin-top: 1.1rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }

  .tk__summaryRow {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
    padding: 0.18rem 0;
  }

  .tk__summaryLabel {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-dim);
    min-width: 11rem;
  }

  .tk__summaryLabel em {
    font-style: normal;
    color: var(--text-faint);
    font-size: 0.72rem;
  }

  .tk__delta {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }

  .tk__delta--good {
    color: var(--accent);
  }
  .tk__delta--bad {
    color: var(--warn);
  }

  .tk__live {
    margin-top: 1.2rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border);
  }

  .tk__chips--live {
    margin-top: 0.7rem;
    min-height: 2rem;
  }

  .tk__note:has(+ *) {
    margin-bottom: 0;
  }

  @media (max-width: 34rem) {
    .tk__row {
      grid-template-columns: 1.7rem minmax(0, 1fr);
    }
    .tk__count {
      grid-column: 2;
      padding-top: 0;
    }
    .tk__note {
      padding-left: 0;
    }
    .tk__summaryLabel {
      min-width: 0;
    }
  }
</style>
