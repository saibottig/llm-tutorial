---
import { t, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tr = t(locale);

// Bytes per parameter, using the effective sizes of the common GGUF mixes
// rather than the nominal bit width (Q4_K_M lands near 4.8 bits, not 4.0).
const QUANTS = [
  { id: 'fp16', label: 'FP16', bytes: 2 },
  { id: 'q8', label: 'INT8 / Q8', bytes: 1 },
  { id: 'q5', label: 'Q5_K_M', bytes: 0.71 },
  { id: 'q4', label: 'Q4_K_M', bytes: 0.6 },
];

// Bandwidth is what decides decode speed, so the picker is a bandwidth picker
// wearing hardware names.
const HARDWARE = [
  { id: 'h100', label: 'HBM3 (H100)', gbs: 3350, vram: 80 },
  { id: 'rtx4090', label: 'GDDR6X (RTX 4090)', gbs: 1008, vram: 24 },
  { id: 'm3max', label: 'Unified (M3 Max)', gbs: 400, vram: 128 },
  { id: 'ddr5', label: 'DDR5 Dual-Channel', gbs: 80, vram: 128 },
];
---

<section
  class="demo vram"
  id="vram-demo"
  data-fits={tr('vram.fits')}
  data-nofits={tr('vram.doesntFit')}
>
  <div class="demo__head">
    <span class="demo__badge">{tr('demo.title')}</span>
    <span class="demo__title">{tr('vram.title')}</span>
  </div>
  <div class="demo__body">
    <div class="demo__controls">
      <label class="field">
        <span class="field__label">
          <span>{tr('vram.params')}</span>
          <span class="field__value" id="v-params-out">70 B</span>
        </span>
        <input type="range" id="v-params" min="1" max="8" step="1" value="6" />
      </label>

      <label class="field">
        <span class="field__label"><span>{tr('vram.quant')}</span></span>
        <select id="v-quant">
          {QUANTS.map((q) => <option value={q.bytes} selected={q.id === 'q4'}>{q.label}</option>)}
        </select>
      </label>

      <label class="field">
        <span class="field__label">
          <span>{tr('vram.context')}</span>
          <span class="field__value" id="v-ctx-out">8k</span>
        </span>
        <input type="range" id="v-ctx" min="1" max="7" step="1" value="3" />
      </label>

      <label class="field">
        <span class="field__label"><span>{tr('vram.hardware')}</span></span>
        <select id="v-hw">
          {
            HARDWARE.map((h) => (
              <option value={h.id} data-gbs={h.gbs} data-vram={h.vram} selected={h.id === 'rtx4090'}>
                {h.label}
              </option>
            ))
          }
        </select>
      </label>
    </div>

    <div class="stats">
      <div class="stat">
        <div class="stat__label">{tr('vram.weights')}</div>
        <div class="stat__value" id="v-weights">–</div>
      </div>
      <div class="stat">
        <div class="stat__label">{tr('vram.kvcache')}</div>
        <div class="stat__value" id="v-kv">–</div>
      </div>
      <div class="stat stat--accent">
        <div class="stat__label">{tr('vram.total')}</div>
        <div class="stat__value" id="v-total">–</div>
      </div>
      <div class="stat stat--warn">
        <div class="stat__label">{tr('vram.throughput')}</div>
        <div class="stat__value" id="v-tps">–</div>
      </div>
    </div>

    <p class="statusline statusline--ok" id="v-status"></p>
    <p class="demo__note" style="margin-top:.7rem">{tr('vram.note')}</p>
  </div>
</section>

<script>
  const root = document.getElementById('vram-demo');
  if (root) {
    const PARAM_STEPS = [1, 3, 7, 13, 34, 70, 120, 405]; // billions
    const CTX_STEPS = [2048, 4096, 8192, 16384, 32768, 131072, 1000000];

    const el = {
      params: document.getElementById('v-params') as HTMLInputElement,
      paramsOut: document.getElementById('v-params-out')!,
      quant: document.getElementById('v-quant') as HTMLSelectElement,
      ctx: document.getElementById('v-ctx') as HTMLInputElement,
      ctxOut: document.getElementById('v-ctx-out')!,
      hw: document.getElementById('v-hw') as HTMLSelectElement,
      weights: document.getElementById('v-weights')!,
      kv: document.getElementById('v-kv')!,
      total: document.getElementById('v-total')!,
      tps: document.getElementById('v-tps')!,
      status: document.getElementById('v-status') as HTMLElement,
    };

    const gb = (n: number) => `${n < 10 ? n.toFixed(1) : Math.round(n)}<small> GB</small>`;
    const fmtCtx = (n: number) => (n >= 1000000 ? '1M' : `${Math.round(n / 1024)}k`);

    function update() {
      const params = PARAM_STEPS[Number(el.params.value) - 1];
      const bytesPerParam = Number(el.quant.value);
      const ctx = CTX_STEPS[Number(el.ctx.value) - 1];
      const opt = el.hw.selectedOptions[0];
      const bandwidth = Number(opt.dataset.gbs);
      const capacity = Number(opt.dataset.vram);

      el.paramsOut.textContent = `${params} B`;
      el.ctxOut.textContent = fmtCtx(ctx);

      // Weights dominate at short context; the KV cache catches up as it grows.
      const weightsGb = (params * 1e9 * bytesPerParam) / 1024 ** 3;
      // Calibrated against a Llama-70B-class layout with grouped-query
      // attention (80 layers, 8 KV heads, head_dim 128, fp16 cache), which
      // works out to 0.31 MB per token — i.e. 4.36e-6 GB per token per
      // billion parameters.
      const kvGb = ctx * params * 4.36e-6;
      const overheadGb = weightsGb * 0.08 + 0.7;
      const total = weightsGb + kvGb + overheadGb;

      el.weights.innerHTML = gb(weightsGb);
      el.kv.innerHTML = gb(kvGb);
      el.total.innerHTML = gb(total);

      const fits = total <= capacity;
      // Decode reads every weight once per token, so bandwidth ÷ model size is
      // the ceiling. Spilling to system RAM collapses it.
      const effective = fits ? bandwidth : 80;
      const tps = effective / weightsGb;
      el.tps.innerHTML = `${tps < 10 ? tps.toFixed(1) : Math.round(tps)}<small> tok/s</small>`;

      el.status.textContent = fits ? root.dataset.fits! : root.dataset.nofits!;
      el.status.className = fits ? 'statusline statusline--ok' : 'statusline statusline--bad';
    }

    [el.params, el.ctx].forEach((i) => i.addEventListener('input', update));
    [el.quant, el.hw].forEach((s) => s.addEventListener('change', update));
    update();
  }
</script>
